{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://soma360-backend-backend.onrender.com/api/v1",
        "EXPO_PUBLIC_WS_API_URL": "ws://soma360-backend-backend.onrender.com/api/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://soma360-backend-backend.onrender.com/api/v1",
        "EXPO_PUBLIC_WS_API_URL": "ws://soma360-backend-backend.onrender.com/api/v1"
      }
    },
    "production": {}
  }
}
