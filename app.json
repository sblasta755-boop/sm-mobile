{
  "expo": {
    "name": "Šoma360",
    "slug": "smartclean-mobile",
    "scheme": "smartclean",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8fbfc"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "za.co.smartclean.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Šoma360 uses the camera to scan site and room QR codes and capture required task evidence.",
        "NSLocationWhenInUseUsageDescription": "Šoma360 captures location only during operational verification such as attendance, scans, and inspections."
      }
    },
    "android": {
      "package": "za.co.smartclean.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f8fbfc"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Šoma360 uses the camera to scan QR codes and capture required evidence."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Šoma360 captures location only during operational verification."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#21779b"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "",
      "router": {},
      "eas": {
        "projectId": "518c03bf-7aeb-4258-9924-97d8c48de803"
      }
    },
    "owner": "sblasta755"
  }
}
