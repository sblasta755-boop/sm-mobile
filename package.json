{
  "name": "smartclean-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "generate-version": "node scripts/version.mjs",
    "postinstall": "npm run generate-version",
    "start": "npm run generate-version && expo start",
    "android": "npm run generate-version && expo start --android",
    "ios": "npm run generate-version && expo start --ios",
    "web": "npm run generate-version && expo start --web",
    "start:lan": "npm run generate-version && expo start --lan",
    "start:tunnel": "npm run generate-version && expo start --tunnel",
    "export:web": "npm run generate-version && expo export --platform web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "expo": "~54.0.37",
    "expo-camera": "~17.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.7",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.13",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.8",
    "jest-expo": "~54.0.18",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.13.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "room-scan": "file:./modules/room-scan"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "eslint": "^9.32.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "typescript": "~5.9.2"
  }
}
