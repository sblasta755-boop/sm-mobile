EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_WS_API_URL=ws://localhost:8000/api/v1
# The no-login customer table page (smart-property-operations' /table/:token
# route) - used to build the waiter's customer-facing QR. NOT the same host
# as EXPO_PUBLIC_API_BASE_URL above; see CUSTOMER_APP_BASE_URL's comment in
# src/api/client.ts for why. Leave unset and the app shows "Customer QR
# isn't set up yet" instead of generating a QR that opens raw JSON.
EXPO_PUBLIC_CUSTOMER_APP_BASE_URL=https://your-customer-app-url.example.com

# --- build-notify service (EAS cloud build + email notification) ---
# Also read by .github/workflows/build-apk.yml (as repo Secrets/Variables,
# not this file) for the same script running in CI on every push.
EXPO_TOKEN=your-eas-access-token
EAS_BUILD_PROFILE=preview
MAIL_TO=you@example.com

# EMAIL_PROVIDER picks which of the two blocks below build-and-notify.mjs
# actually uses - "smtp" (default) or "brevo" - same switch as the
# backend's own EMAIL_PROVIDER (app/services/email.py). Only the chosen
# provider's block needs real values; the other is ignored.
EMAIL_PROVIDER=brevo

# --- used when EMAIL_PROVIDER=smtp ---
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM="Builds <builds@yourdomain.com>"

# --- used when EMAIL_PROVIDER=brevo ---
BREVO_API_KEY=
BREVO_FROM_EMAIL=sblasta755@gmail.com
BREVO_FROM_NAME=Soma360